#!/usr/bin/env node
import { realpathSync } from "node:fs";
import { dirname, join } from "node:path";
import { pathToFileURL } from "node:url";
const [maj] = process.versions.node.split(".").map(Number);
if (maj < 18) { console.error(`cs: Node 18+ required (found ${process.versions.node})`); process.exit(1); }
await import(pathToFileURL(join(dirname(dirname(realpathSync(process.argv[1]))), "dist", "cs.js")).href);
